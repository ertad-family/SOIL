@article{chanson_will_2024,
	title = {Will {I} survive? {Focus} on {Legitimacy} rather than {Profitability}! {A} {csQCA} study of the organizational death of {French} online banks and ‘’so-called’’ neobanks.},
	volume = {27-3},
	copyright = {https://creativecommons.org/licenses/by-sa/4.0/},
	issn = {1287-1141, 2261-5512},
	shorttitle = {Will {I} survive?},
	url = {https://journals.openedition.org/fcs/13112},
	doi = {10.4000/13iee},
	abstract = {In an emerging market, should new firms prioritize profitability or legitimacy for survival? Our study focuses on the survival conditions of the organizational populations of online banks and ‘’so-called’’ neobanks in the French retail banking market from 1994 to 2022. We conduct a crisp-set qualitative comparative analysis on all relevant cases: 17 survivors and 13 companies that have experienced organizational death. We find that Pragmatic Legitimacy (conferred by the market) is both necessary and sufficient for organizational survival or death, whereas profitability is a necessary condition.
          , 
            Dans un nouveau marché, les entreprises doivent-elles se concentrer sur leur profitabilité ou leur légitimité pour survivre ? Notre étude analyse les conditions de survie des populations organisationnelles de banques en ligne et des néo-banques sur le marché bancaire français entre 1994 et 2022. Une analyse csQCA est appliquée sur tous les cas pertinents : 17 survivantes et 13 entreprises mortes. La légitimité pragmatique (conférée par le marché) est la condition nécessaire et suffisante de la survie ou de la mort organisationnelle, tandis que la profitabilité est une condition nécessaire.},
	urldate = {2026-01-03},
	journal = {Finance Contrôle Stratégie},
	author = {Chanson, Guillaume and Rocchi, Jean-Michel},
	year = {2024},
}

