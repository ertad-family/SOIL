# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=your-jwt-secret

# Postgres Configuration
POSTGRES_URL=postgres://user:password@host:port/database
POSTGRES_PRISMA_URL=postgres://user:password@host:port/database?pgbouncer=true
POSTGRES_URL_NON_POOLING=postgres://user:password@host:port/database
POSTGRES_HOST=your-db-host
POSTGRES_DATABASE=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your-password

# Google Cloud Vertex AI (Imagen 4)
GOOGLE_CLOUD_PROJECT_ID=your-project-id
VERTEX_AI_LOCATION=us-central1
GOOGLE_APPLICATION_CREDENTIALS=/path/to/credentials.json

# LLM Provider Configuration
LLM_PROVIDER=gemini
LLM_FALLBACK_PROVIDER=claude

# Claude API Configuration
CLAUDE_API_KEY=your-claude-api-key
CLAUDE_MODEL=claude-sonnet-4-20250514

# Gemini API Configuration
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash

# Resend Email Configuration
RESEND_API_KEY=your-resend-api-key

# Email Worker Configuration
# URL of the SOIL-worker Vercel deployment (triggers email sending immediately)
WORKER_URL=https://soil-worker.vercel.app

# Analytics Configuration
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# GitHub Bug Report Configuration
# Token requires 'repo' scope to create issues
GITHUB_TOKEN=ghp_your_github_token

# Zotero API Configuration
# Group ID: 6367540 (Studies of Organizational Illness and Loss)
ZOTERO_API_KEY=your-zotero-api-key
ZOTERO_GROUP_ID=6367540
